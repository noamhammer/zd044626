zendesk.messaging_trigger noammsgtrigger3 {
  name = "noammsgtrigger3"
  description = "bla"
  definition = {
    event = "conversation_message"
    actions = [
      [
        "wait",
        20,
      ],
    ]
    condition = [
      "and",
      [
        "eq",
        "@day_of_week",
        4,
      ],
    ]
  }
  active = true
  channels = [
    zendesk.channel.instance.Messaging,
    zendesk.channel.instance.Google_RCS@s,
  ]
  fire_once = false
  _alias = "noammsgtrigger3"
}
