zendesk.trigger autosolve_gemini_r4b___delete_me {
  title = "autosolve gemini r4b - delete me"
  active = false
  default = false
  actions = [
    {
      field = "current_tags"
      value = [
        zendesk.tag.instance.x,
      ]
    },
  ]
  conditions = {
    all = [
      {
        field = "update_type"
        operator = "is"
        value = "Create"
      },
    ]
    any = []
  }
  description = "Inactive test trigger to add tag x on ticket creation"
  raw_title = "autosolve gemini r4b - delete me"
  category_id = zendesk.trigger_category.instance.Notifications
  _alias = "autosolve gemini r4b - delete me"
}
